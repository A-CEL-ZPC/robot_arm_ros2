<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <link name="gripper_base_link">
        <visual>
            <geometry>
                <box size="0.2 0.06 0.02"/>
            </geometry>
            <origin xyz="0.0 0.0 0.01" rpy="0.0 0.0 0.0"/>
            <material name = "dark_green" />
        </visual>
        <collision>
            <geometry>
                <box size="0.2 0.06 0.02"/>
            </geometry>
            <origin xyz="0.0 0.0 0.01" rpy="0.0 0.0 0.0"/>
        </collision>
        <inertial>
            <mass value="0.3"/>
            <origin xyz="0 0 0.01" rpy="0 0 0"/>
            <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0010" iyz="0.0" izz="0.0011"/>
        </inertial>
    </link>
    <link name="gripper_left_finger_link">
        <visual>
            <geometry>
                <box size="0.02 0.06 0.08"/>
            </geometry>
            <origin xyz="0.0 0.0 0.04" rpy="0.0 0.0 0.0"/>
            <material name = "light_green" />
        </visual>
        <collision>
            <geometry>
                <box size="0.02 0.06 0.08"/>
            </geometry>
            <origin xyz="0.0 0.0 0.04" rpy="0.0 0.0 0.0"/>
        </collision>
        <inertial>
            <mass value="0.1"/>
            <origin xyz="0 0 0.04" rpy="0 0 0"/>
            <inertia ixx="0.00008" ixy="0.0" ixz="0.0" iyy="0.00006" iyz="0.0" izz="0.00003"/>
        </inertial>
    </link>

    <link name="gripper_right_finger_link">
        <visual>
            <geometry>
                <box size="0.02 0.06 0.08"/>
            </geometry>
            <origin xyz="0.0 0.0 0.04" rpy="0.0 0.0 0.0"/>
            <material name = "light_green" />
        </visual>
        <collision>
            <geometry>
                <box size="0.02 0.06 0.08"/>
            </geometry>
            <origin xyz="0.0 0.0 0.04" rpy="0.0 0.0 0.0"/>
        </collision>
        <inertial>
            <mass value="0.1"/>
            <origin xyz="0 0 0.04" rpy="0 0 0"/>
            <inertia ixx="0.00008" ixy="0.0" ixz="0.0" iyy="0.00006" iyz="0.0" izz="0.00003"/>
        </inertial>
    </link>

    <joint name="gripper_left_finger_joint" type="prismatic">
        <parent link="gripper_base_link"/>
        <child link="gripper_left_finger_link"/>
        <origin xyz="-0.07 0.0 0.02" rpy="0.0 0.0 0.0"/>
        <axis xyz="1 0.0 0.0"/>
        <limit lower="0.0" upper="0.06" effort="1000.0" velocity="1.0"/>
    </joint>

    <joint name="gripper_right_finger_joint" type="prismatic">
        <parent link="gripper_base_link"/>
        <child link="gripper_right_finger_link"/>
        <origin xyz="0.07 0.0 0.02" rpy="0.0 0.0 0.0"/>
        <axis xyz="1 0.0 0.0"/>
        <!-- 注意：不用 <mimic>！Gazebo 11 不执行 URDF mimic（右指会变成自由关节），
             且 MoveIt 不会把 mimic 关节写入控制轨迹。右指由 ros2_control 显式控制，
             目标值 = -左指（见 SRDF group_state 与 grasp_demo） -->
        <limit lower="-0.06" upper="0.0" effort="1000.0" velocity="1.0"/>
    </joint>
</robot>
