<?xml version="1.0"?>
<sdf version="1.6">
  <world name="myrobot_workshop">

    <!-- 地面：内联定义（不用 model://ground_plane，避免 gzserver 访问在线
         模型数据库 models.gazebosim.org 导致世界加载挂起；离线自包含） -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Grey</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- 太阳光：内联定义（同地面，避免 model://sun 触发在线数据库查询） -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- 桌子：桌面高 0.4m，桌面上放目标方块 -->
    <model name="table">
      <pose>0.5 0 0 0 0 0</pose>

      <link name="table_top">
        <pose>0 0 0.4 0 0 0</pose>
        <collision name="collision">
          <geometry>
            <box><size>0.6 0.6 0.05</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.6 0.6 0.05</size></box>
          </geometry>
          <material>
            <ambient>0.65 0.45 0.2 1</ambient>
            <diffuse>0.65 0.45 0.2 1</diffuse>
          </material>
        </visual>
        <inertial>
          <mass>5</mass>
          <inertia>
            <ixx>0.305</ixx><iyy>0.305</iyy><izz>0.5</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
      </link>

      <link name="table_leg1">
        <pose>-0.25 0.25 0.2 0 0 0</pose>
        <collision name="collision">
          <geometry>
            <box><size>0.05 0.05 0.4</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.05 0.05 0.4</size></box>
          </geometry>
        </visual>
        <inertial>
          <mass>0.5</mass>
          <inertia>
            <ixx>0.017</ixx><iyy>0.017</iyy><izz>0.0002</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
      </link>
      <link name="table_leg2">
        <pose>0.25 0.25 0.2 0 0 0</pose>
        <collision name="collision">
          <geometry>
            <box><size>0.05 0.05 0.4</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.05 0.05 0.4</size></box>
          </geometry>
        </visual>
        <inertial>
          <mass>0.5</mass>
          <inertia>
            <ixx>0.017</ixx><iyy>0.017</iyy><izz>0.0002</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
      </link>
      <link name="table_leg3">
        <pose>-0.25 -0.25 0.2 0 0 0</pose>
        <collision name="collision">
          <geometry>
            <box><size>0.05 0.05 0.4</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.05 0.05 0.4</size></box>
          </geometry>
        </visual>
        <inertial>
          <mass>0.5</mass>
          <inertia>
            <ixx>0.017</ixx><iyy>0.017</iyy><izz>0.0002</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
      </link>
      <link name="table_leg4">
        <pose>0.25 -0.25 0.2 0 0 0</pose>
        <collision name="collision">
          <geometry>
            <box><size>0.05 0.05 0.4</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.05 0.05 0.4</size></box>
          </geometry>
        </visual>
        <inertial>
          <mass>0.5</mass>
          <inertia>
            <ixx>0.017</ixx><iyy>0.017</iyy><izz>0.0002</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
      </link>

      <joint name="leg1_joint" type="fixed">
        <parent>table_top</parent>
        <child>table_leg1</child>
      </joint>
      <joint name="leg2_joint" type="fixed">
        <parent>table_top</parent>
        <child>table_leg2</child>
      </joint>
      <joint name="leg3_joint" type="fixed">
        <parent>table_top</parent>
        <child>table_leg3</child>
      </joint>
      <joint name="leg4_joint" type="fixed">
        <parent>table_top</parent>
        <child>table_leg4</child>
      </joint>
    </model>

    <!-- 目标方块：放在桌面上（桌面顶面 z≈0.425，方块中心 z=0.45） -->
    <model name="target_box">
      <pose>0.65 0 0.45 0 0 0</pose>
      <link name="box">
        <collision name="collision">
          <geometry>
            <box><size>0.05 0.05 0.05</size></box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>5.0</mu>
                <mu2>5.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.05 0.05 0.05</size></box>
          </geometry>
          <material>
            <ambient>0.8 0.1 0.1 1</ambient>
            <diffuse>0.8 0.1 0.1 1</diffuse>
          </material>
        </visual>
        <inertial>
          <mass>0.1</mass>
          <inertia>
            <ixx>0.000042</ixx><iyy>0.000042</iyy><izz>0.000042</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
      </link>
    </model>

  </world>
</sdf>
